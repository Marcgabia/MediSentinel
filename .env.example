# Copy to .env (or run `npm run setup`, which generates secure random keys for you).
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medisentinel_audit
DB_TEST_NAME=medisentinel_test

# Session cookie signing (min 32 chars). Set COOKIE_SECURE=true behind HTTPS.
SESSION_SECRET=
COOKIE_SECURE=false
# TRUST_PROXY=1

# Audit integrity (HMAC-SHA256). Never commit real values. Losing this key makes existing
# records unverifiable; after rotation keep old keys in AUDIT_SIGNING_KEYS_RETIRED (id:key,id:key).
AUDIT_SIGNING_KEY_ID=k1
AUDIT_SIGNING_KEY=
AUDIT_SIGNING_KEYS_RETIRED=

# Encrypts integration secrets at rest (AES-256-GCM, 64 hex chars).
CREDENTIAL_ENCRYPTION_KEY=

# First administrator (used only when the users table is empty).
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@medisentinel.local
ADMIN_INITIAL_PASSWORD=

# Optional
# PUBLIC_BASE_URL=https://audit.pharmacy.local
# AUTO_MIGRATE=true
# API_RATE_LIMIT_PER_MINUTE=1200
# LOGIN_RATE_LIMIT=30

# Keep the Demo POS / Demo Inventory sample systems live (after npm run seed:demo)
# DEMO_TRAFFIC=true
