{{> head}}
<div class="mx-auto max-w-2xl space-y-5">
  <div>
    <h1 class="page-title">API key created</h1>
    <p class="page-sub">{{source.name}}{{#if label}} · {{label}}{{/if}}</p>
  </div>
  <div class="notice border-amber-200 bg-amber-50 text-amber-800">Copy the secret now. It will not be shown again.</div>
  <div class="card card-body space-y-4">
    <div>
      <label class="label" for="keyId">Key ID</label>
      <div class="flex gap-2"><input id="keyId" class="input mono" value="{{keyId}}" readonly /><button type="button" class="btn-secondary" data-copy="keyId">Copy</button></div>
    </div>
    <div>
      <label class="label" for="secret">Secret</label>
      <div class="flex gap-2"><input id="secret" class="input mono" value="{{secret}}" readonly autocomplete="off" /><button type="button" class="btn-secondary" data-copy="secret">Copy</button></div>
    </div>
    <div>
      <div class="label">Environment variables</div>
      <pre class="mono overflow-x-auto rounded-lg bg-slate-50 p-3 text-slate-700">MEDISENTINEL_URL={{apiBase}}
MEDISENTINEL_SOURCE={{source.systemCode}}
MEDISENTINEL_KEY_ID={{keyId}}
MEDISENTINEL_SECRET=&lt;secret&gt;</pre>
    </div>
  </div>
  <div class="flex justify-end"><a class="btn-primary" href="/integrations/{{source.id}}">Done</a></div>
</div>
{{> footer}}
