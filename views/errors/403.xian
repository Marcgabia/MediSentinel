{{> head}}
<div class="mx-auto max-w-md py-16 text-center">
  <div class="text-sm font-medium text-red-600">403</div>
  <h1 class="mt-2 text-2xl font-semibold text-slate-900">Access denied</h1>
  <p class="mt-2 text-slate-500">{{message}}</p>
  <a href="/dashboard" class="btn-primary mt-6">Go to dashboard</a>
</div>
{{> footer}}
