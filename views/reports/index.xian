{{> head}}
<div class="page-head">
  <div>
    <h1 class="page-title">Audit Reports</h1>
    <p class="page-sub">Filter, print or export to CSV</p>
  </div>
</div>
<div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
  {{#each reports}}
  <a href="/reports/{{code}}" class="card group flex items-start gap-4 p-4 transition hover:border-slate-300">
    <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-slate-100 text-slate-500 group-hover:bg-emerald-50 group-hover:text-emerald-600">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
    </span>
    <span>
      <span class="block font-medium text-slate-900">{{name}}</span>
      <span class="mt-0.5 block text-xs text-slate-500">{{description}}</span>
    </span>
  </a>
  {{/each}}
</div>
{{> footer}}
