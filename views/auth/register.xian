<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <title>Create account · MediSentinel</title>
  <script src="/js/theme.js?v=3"></script>
  <link rel="stylesheet" href="/css/app.css?v=3" />
  <link rel="icon" href="/img/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/img/favicon-64.png?v=3" type="image/png" sizes="64x64" />
  <link rel="apple-touch-icon" href="/img/logo-192.png?v=3" />
</head>
<body class="min-h-screen">
  <div class="auth-shell">
    {{> auth-hero}}

    <section class="auth-panel">
      <button type="button" class="icon-btn absolute right-4 top-4 sm:right-6 sm:top-6" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>

      <div class="auth-card">
        <div class="mb-8 flex items-center gap-2.5 lg:hidden">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-[#ffffff] p-1 shadow-sm ring-1 ring-slate-200/80"><img src="/img/logo-mark.png?v=3" alt="" class="h-full w-full object-contain" /></span>
          <span class="text-lg font-bold tracking-tight text-slate-900">MediSentinel</span>
        </div>

        {{#if registered}}
        <div class="text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 ring-8 ring-emerald-50/50">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          <h1 class="mt-6 text-2xl font-semibold tracking-tight text-slate-900">Request submitted</h1>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">Your account <span class="font-semibold text-slate-800">{{registered}}</span> was created and is waiting for an administrator to approve it. You can sign in once it has been approved.</p>
          <a href="/login" class="btn-primary mt-8 w-full py-2.5">Back to sign in</a>
        </div>
        {{else}}
        <h1 class="text-[28px] font-semibold tracking-tight text-slate-900">Create your account</h1>
        <p class="mt-1.5 text-sm text-slate-500">New accounts start with read-only access and need administrator approval before first sign-in.</p>

        <div class="mt-6 space-y-3">{{> flash}}</div>

        <form method="POST" action="/register" class="mt-6 space-y-4" autocomplete="on">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          <div>
            <label class="label" for="fullName">Full name</label>
            <input class="input py-2.5" id="fullName" name="fullName" type="text" required maxlength="150" autocomplete="name" value="{{form.fullName}}" placeholder="Juan Dela Cruz" autofocus />
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for="username">Username</label>
              <input class="input py-2.5" id="username" name="username" type="text" required minlength="3" maxlength="60" pattern="[A-Za-z0-9._\-]{3,60}" autocomplete="username" value="{{form.username}}" placeholder="juan.delacruz" />
            </div>
            <div>
              <label class="label" for="email">Email</label>
              <input class="input py-2.5" id="email" name="email" type="email" required maxlength="190" autocomplete="email" value="{{form.email}}" placeholder="you@pharmacy.local" />
            </div>
          </div>
          <div>
            <label class="label" for="password">Password</label>
            <div class="relative">
              <input class="input py-2.5 pr-11" id="password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" data-strength="pw-meter" />
              <button type="button" class="absolute right-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-reveal="password" aria-label="Show password" title="Show password">
                <svg data-eye-open class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-eye-closed class="hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 19c-6.5 0-10-7-10-7a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c6.5 0 10 7 10 7a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24M1 1l22 22"/></svg>
              </button>
            </div>
            <div id="pw-meter" class="mt-2 grid grid-cols-4 gap-1" aria-hidden="true">
              <span class="h-1 rounded-full bg-slate-200"></span><span class="h-1 rounded-full bg-slate-200"></span><span class="h-1 rounded-full bg-slate-200"></span><span class="h-1 rounded-full bg-slate-200"></span>
            </div>
            <ul class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-xs text-slate-400" data-rules-for="password">
              <li data-rule="len">10+ characters</li>
              <li data-rule="upper">An uppercase letter</li>
              <li data-rule="lower">A lowercase letter</li>
              <li data-rule="digit">A number</li>
            </ul>
          </div>
          <div>
            <label class="label" for="confirmPassword">Confirm password</label>
            <input class="input py-2.5" id="confirmPassword" name="confirmPassword" type="password" required minlength="10" maxlength="128" autocomplete="new-password" data-match="password" />
            <p class="help hidden text-red-600" data-match-error>Passwords do not match.</p>
          </div>
          <button type="submit" class="btn-primary w-full py-2.5 text-[15px]">Create account</button>
        </form>

        <p class="mt-8 text-center text-sm text-slate-500">
          Already have an account? <a href="/login" class="link">Sign in</a>
        </p>
        {{/if}}
      </div>
    </section>
  </div>
  <script src="/js/auth.js?v=3"></script>
</body>
</html>
