<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <title>Sign in · MediSentinel</title>
  <script src="/js/theme.js?v=3"></script>
  <link rel="stylesheet" href="/css/app.css?v=3" />
  <link rel="icon" href="/img/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/img/favicon-64.png?v=3" type="image/png" sizes="64x64" />
  <link rel="apple-touch-icon" href="/img/logo-192.png?v=3" />
</head>
<body class="min-h-screen">
  <div class="auth-shell">
    {{> auth-hero}}

    <section class="auth-panel">
      <button type="button" class="icon-btn absolute right-4 top-4 sm:right-6 sm:top-6" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>

      <div class="auth-card">
        <div class="mb-8 flex items-center gap-2.5 lg:hidden">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-[#ffffff] p-1 shadow-sm ring-1 ring-slate-200/80"><img src="/img/logo-mark.png?v=3" alt="" class="h-full w-full object-contain" /></span>
          <span class="text-lg font-bold tracking-tight text-slate-900">MediSentinel</span>
        </div>

        <h1 class="text-[28px] font-semibold tracking-tight text-slate-900">Welcome back</h1>
        <p class="mt-1.5 text-sm text-slate-500">Sign in to your MediSentinel account to continue.</p>

        <div class="mt-6 space-y-3">{{> flash}}</div>

        <form method="POST" action="/login" class="mt-6 space-y-4">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          <div>
            <label class="label" for="username">Email or username</label>
            <div class="relative">
              <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1"/></svg>
              <input class="input py-2.5 pl-9" id="username" name="username" type="text" required autofocus autocomplete="username" maxlength="190" placeholder="you@pharmacy.local" />
            </div>
          </div>
          <div>
            <label class="label" for="password">Password</label>
            <div class="relative">
              <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
              <input class="input py-2.5 pl-9 pr-11" id="password" name="password" type="password" required autocomplete="current-password" maxlength="128" placeholder="••••••••••" />
              <button type="button" class="absolute right-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" data-reveal="password" aria-label="Show password" title="Show password">
                <svg data-eye-open class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg data-eye-closed class="hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 19c-6.5 0-10-7-10-7a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c6.5 0 10 7 10 7a18.5 18.5 0 01-2.16 3.19M14.12 14.12a3 3 0 11-4.24-4.24M1 1l22 22"/></svg>
              </button>
            </div>
          </div>
          <button type="submit" class="btn-primary w-full py-2.5 text-[15px]">Sign in</button>
        </form>

        {{#if allowRegistration}}
        <p class="mt-8 text-center text-sm text-slate-500">
          Don't have an account yet? <a href="/register" class="link">Create an account</a>
        </p>
        {{else}}
        <p class="mt-8 text-center text-sm text-slate-500">Need access? Ask a MediSentinel administrator to create your account.</p>
        {{/if}}
      </div>
    </section>
  </div>
  <script src="/js/auth.js?v=3"></script>
</body>
</html>
