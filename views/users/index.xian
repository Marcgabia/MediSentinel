{{> head}}
<div class="page-head">
  <div>
    <h1 class="page-title">User Management</h1>
    <p class="page-sub">MediSentinel accounts{{#if pendingAccounts}} · <a class="link" href="/users?status=pending">{{pendingAccounts}} awaiting approval</a>{{/if}}</p>
  </div>
  <div class="actions">
    <a href="/users/roles" class="btn-secondary">Roles</a>
    <a href="/users/new" class="btn-primary">New user</a>
  </div>
</div>
<div class="card">
  <form method="GET" action="/users" class="grid grid-cols-1 gap-3 border-b border-slate-100 p-4 md:grid-cols-[2fr_1fr_1fr_auto]">
    <input class="input" name="search" value="{{filters.search}}" placeholder="Name, username or email" aria-label="Search" />
    <select class="input" name="roleId" data-autosubmit aria-label="Role"><option value="">All roles</option>{{#each roles}}<option value="{{id}}" {{selected id ../filters.roleId}}>{{name}}</option>{{/each}}</select>
    <select class="input" name="status" data-autosubmit aria-label="Status"><option value="">All statuses</option><option value="active" {{selected "active" filters.status}}>Active</option><option value="inactive" {{selected "inactive" filters.status}}>Inactive</option><option value="pending" {{selected "pending" filters.status}}>Pending approval</option></select>
    <button class="btn-primary" type="submit">Filter</button>
  </form>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
    <tbody>{{#each users}}<tr>
      <td>
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">{{initials fullName}}</span>
          <div><div class="cell-main">{{fullName}}{{#if (eq id @root.currentUser.id)}} <span class="text-xs font-normal text-slate-400">(you)</span>{{/if}}</div><div class="cell-sub">{{email}}</div></div>
        </div>
      </td>
      <td class="text-slate-600">{{roleName}}</td>
      <td>{{#if isActive}}{{badge "ACTIVE"}}{{else}}{{#if isPending}}{{badge "PENDING_APPROVAL" "Pending approval"}}{{else}}{{badge "INACTIVE"}}{{/if}}{{/if}}{{#if isLocked}} {{badge "LOCKED"}}{{/if}}</td>
      <td class="whitespace-nowrap text-slate-500">{{#if lastLoginAt}}{{ago lastLoginAt}}{{else}}Never{{/if}}</td>
      <td class="whitespace-nowrap text-right">
        <div class="flex justify-end gap-1">
          <a class="btn-ghost btn-sm" href="/users/{{id}}/edit">Edit</a>
          {{#if isLocked}}<form method="POST" action="/users/{{id}}/unlock">{{> csrf}}<button class="btn-ghost btn-sm" type="submit">Unlock</button></form>{{/if}}
          {{#unless (eq id @root.currentUser.id)}}
          <form method="POST" action="/users/{{id}}/active" data-confirm="{{#if isActive}}Deactivate{{else}}{{#if isPending}}Approve{{else}}Activate{{/if}}{{/if}} {{fullName}}?">{{> csrf}}<input type="hidden" name="active" value="{{#if isActive}}false{{else}}true{{/if}}" /><button class="btn-ghost btn-sm {{#if isActive}}text-red-600{{else}}text-emerald-700{{/if}}" type="submit">{{#if isActive}}Deactivate{{else}}{{#if isPending}}Approve{{else}}Activate{{/if}}{{/if}}</button></form>
          {{/unless}}
        </div>
      </td>
    </tr>{{else}}<tr><td colspan="5" class="empty">No users</td></tr>{{/each}}</tbody>
  </table></div>
</div>
{{> footer}}
