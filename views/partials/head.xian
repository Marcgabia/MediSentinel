<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <title>{{title}} · MediSentinel</title>
  <script src="/js/theme.js?v=3"></script>
  <link rel="stylesheet" href="/css/app.css?v=3" />
  <link rel="icon" href="/img/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/img/favicon-64.png?v=3" type="image/png" sizes="64x64" />
  <link rel="apple-touch-icon" href="/img/logo-192.png?v=3" />
</head>
<body class="min-h-screen">
<div class="flex min-h-screen">
  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-slate-200/80 bg-surface transition-transform lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
    <a href="/dashboard" class="flex items-center gap-3 px-5 pb-4 pt-5">
      <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-[#ffffff] p-1 shadow-sm ring-1 ring-slate-200/80"><img src="/img/logo-mark.png?v=3" alt="" class="h-full w-full object-contain" /></span>
      <span class="leading-tight">
        <span class="block text-[15px] font-bold tracking-tight text-slate-900">MediSentinel</span>
        <span class="block text-[11px] font-medium text-slate-400">Pharmacy audit trail</span>
      </span>
    </a>

    <nav class="flex-1 space-y-5 overflow-y-auto px-3 pb-4 pt-2">
      <div class="space-y-0.5">
        <div class="nav-section">Overview</div>
        {{#if (can "dashboard.view")}}<a href="/dashboard" class="nav-item {{active currentPath '/dashboard'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Dashboard</a>{{/if}}
        {{#if (can "audit.view")}}<a href="/audit" class="nav-item {{active currentPath '/audit'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>Audit Trail</a>{{/if}}
        {{#if (can "activity.view")}}<a href="/user-activity" class="nav-item {{active currentPath '/user-activity'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2M16 3.13a4 4 0 010 7.75M21 21v-2a4 4 0 00-3-3.85"/></svg>User Activity</a>{{/if}}
        {{#if (can "integrations.view")}}<a href="/integrations" class="nav-item {{active currentPath '/integrations'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3v4M16 3v4M6 7h12v4a6 6 0 01-12 0zM12 17v4"/></svg>System Integrations</a>{{/if}}
      </div>

      {{#if (or (can "alerts.view") (can "investigations.view") (can "reports.view"))}}
      <div class="space-y-0.5">
        <div class="nav-section">Review</div>
        {{#if (can "alerts.view")}}<a href="/alerts" class="nav-item {{active currentPath '/alerts'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4M12 17h.01"/></svg>Suspicious Activities</a>{{/if}}
        {{#if (can "investigations.view")}}<a href="/investigations" class="nav-item {{active currentPath '/investigations'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>Investigations</a>{{/if}}
        {{#if (can "reports.view")}}<a href="/reports" class="nav-item {{active currentPath '/reports'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>Audit Reports</a>{{/if}}
      </div>
      {{/if}}

      {{#if (can "qa.view")}}
      <div class="space-y-0.5">
        <div class="nav-section">Quality</div>
        <a href="/qa" class="nav-item {{active currentPath '/qa'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>Quality Assurance</a>
        <a href="/qa/findings" class="nav-item {{active currentPath '/qa/findings'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H5.17L4 17.17z"/><path d="M12 8v3M12 14h.01"/></svg>QA Findings</a>
      </div>
      {{/if}}

      <div class="space-y-0.5">
        <div class="nav-section">Administration</div>
        {{#if (can "notifications.view")}}<a href="/notifications" class="nav-item {{active currentPath '/notifications'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>Notifications
          {{#if unreadNotifications}}<span class="ml-auto rounded-full bg-brand-600 px-1.5 py-px text-[11px] font-semibold text-onbrand dark:bg-brand-500">{{unreadNotifications}}</span>{{/if}}</a>{{/if}}
        {{#if (can "users.manage")}}<a href="/users" class="nav-item {{active currentPath '/users'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0112 0v1M19 8v6M22 11h-6"/></svg>User Management
          {{#if pendingAccounts}}<span class="ml-auto rounded-full bg-amber-100 px-1.5 py-px text-[11px] font-semibold text-amber-800" title="Accounts awaiting approval">{{pendingAccounts}}</span>{{/if}}</a>{{/if}}
        <a href="/settings" class="nav-item {{active currentPath '/settings'}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>Settings</a>
      </div>
    </nav>

    <div class="border-t border-slate-100 p-3">
      <div class="flex items-center gap-3 rounded-xl bg-slate-50 p-2.5">
        <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-600 text-xs font-semibold text-onbrand dark:bg-brand-500">{{initials currentUser.fullName}}</span>
        <span class="min-w-0 flex-1 leading-tight">
          <span class="block truncate text-sm font-semibold text-slate-900">{{currentUser.fullName}}</span>
          <span class="block truncate text-xs text-slate-500">{{currentUser.roleName}}</span>
        </span>
        <form method="POST" action="/logout">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          <button type="submit" class="icon-btn h-8 w-8" aria-label="Logout" title="Logout">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg></button>
        </form>
      </div>
    </div>
  </aside>
  <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-[#0b1020]/50 backdrop-blur-sm lg:hidden"></div>

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="topbar sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-slate-200/80 bg-surface/85 px-4 backdrop-blur-md sm:px-6">
      <button type="button" id="sidebar-toggle" class="icon-btn lg:hidden" aria-label="Menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      {{#if (can "audit.view")}}
      <form method="GET" action="/audit" class="relative hidden w-full max-w-md sm:block">
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        <input name="q" class="input rounded-xl border-transparent bg-slate-100 pl-9 shadow-none focus:bg-surface" placeholder="Search events, users, records…" aria-label="Search audit trail" />
      </form>
      {{/if}}
      <div class="ml-auto flex items-center gap-1">
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle dark mode">
          <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        {{#if (can "notifications.view")}}
        <div class="relative">
          <button type="button" id="notif-toggle" class="icon-btn" aria-label="Notifications">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
            {{#if unreadNotifications}}<span class="absolute right-1 top-1 flex h-4 min-w-[1rem] items-center justify-center rounded-full {{#if unreadCritical}}bg-red-500{{else}}bg-brand-500{{/if}} px-1 text-[10px] font-semibold text-onbrand ring-2 ring-surface">{{unreadNotifications}}</span>{{/if}}
          </button>
          <div id="notif-panel" class="absolute right-0 z-50 mt-2 hidden w-96 max-w-[90vw] overflow-hidden rounded-2xl border border-slate-200 bg-surface shadow-pop">
            <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
              <span class="text-sm font-semibold text-slate-900">Notifications</span>
              <a href="/notifications" class="card-link">View all</a>
            </div>
            <div id="notif-items" class="max-h-96 divide-y divide-slate-100 overflow-y-auto text-sm"><div class="empty">Loading…</div></div>
          </div>
        </div>
        {{/if}}
        <div class="relative ml-1">
          <button type="button" data-toggle="user-menu" class="flex items-center gap-2.5 rounded-xl py-1 pl-1 pr-2 transition hover:bg-slate-100">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-xs font-semibold text-onbrand dark:bg-brand-500">{{initials currentUser.fullName}}</span>
            <span class="hidden text-left leading-tight md:block">
              <span class="block text-sm font-semibold text-slate-900">{{currentUser.fullName}}</span>
              <span class="block text-xs text-slate-500">{{currentUser.roleName}}</span>
            </span>
            <svg class="hidden h-4 w-4 text-slate-400 md:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div id="user-menu" class="absolute right-0 z-50 mt-2 hidden w-64 overflow-hidden rounded-2xl border border-slate-200 bg-surface py-1.5 text-sm shadow-pop">
            <div class="px-3.5 pb-2 pt-1.5">
              <div class="mb-1.5 text-[11px] font-semibold uppercase tracking-wider text-slate-400">Appearance</div>
              <div class="theme-seg" role="group" aria-label="Theme">
                <button type="button" class="theme-opt" data-theme-set="light" aria-pressed="false">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>Light</button>
                <button type="button" class="theme-opt" data-theme-set="dark" aria-pressed="false">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>Dark</button>
                <button type="button" class="theme-opt" data-theme-set="system" aria-pressed="false">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>System</button>
              </div>
            </div>
            <div class="divider my-1"></div>
            <a href="/settings?tab=password" class="menu-item">
              <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>Change password</a>
            <form method="POST" action="/logout"><input type="hidden" name="_csrf" value="{{csrfToken}}" /><button class="menu-item" type="submit">
              <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>Logout</button></form>
          </div>
        </div>
      </div>
    </header>
    <main class="mx-auto w-full max-w-[1400px] flex-1 space-y-6 p-4 sm:p-6 lg:p-8">
      {{> flash}}
