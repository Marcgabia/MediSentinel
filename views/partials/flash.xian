{{#each error_msg}}
<div class="notice flex items-start gap-2 border-red-200 bg-red-50 text-red-700" role="alert">
  <svg class="mt-0.5 h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg><span>{{this}}</span>
</div>
{{/each}}
{{#each success_msg}}
<div class="notice flex items-start gap-2 border-emerald-200 bg-emerald-50 text-emerald-700" role="status">
  <svg class="mt-0.5 h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg><span>{{this}}</span>
</div>
{{/each}}
