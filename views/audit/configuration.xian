{{> head}}
<div class="page-head">
  <div>
    <h1 class="page-title">Configuration Change History</h1>
    <p class="page-sub">{{number pagination.total}} configuration change(s) reported by connected systems · before-and-after comparison</p>
  </div>
</div>
{{> audit-tabs}}

<form method="GET" action="/audit/configuration" class="card no-print">
  <div class="grid grid-cols-1 gap-3 p-4 md:grid-cols-4 xl:grid-cols-[1fr_1fr_1fr_1fr_1fr_1fr_auto]">
    <div><label class="label">Configuration</label><select class="input" name="actionType"><option value="">All</option>{{#each options.configurationTypes}}<option value="{{code}}" {{selected code ../filters.actionType}}>{{name}}</option>{{/each}}</select></div>
    <div><label class="label">System</label><select class="input" name="sourceSystemId"><option value="">All</option>{{#each options.sources}}<option value="{{id}}" {{selected id ../filters.sourceSystemId}}>{{name}}</option>{{/each}}</select></div>
    <div><label class="label">Branch</label><select class="input" name="branchId"><option value="">All</option>{{#each options.branches}}<option value="{{this}}" {{selected this ../filters.branchId}}>{{this}}</option>{{/each}}</select></div>
    <div><label class="label">Changed by (user ID or username)</label><input class="input" name="user" value="{{filters.user}}" /></div>
    <div><label class="label">From</label><input class="input" type="date" name="from" value="{{filters.from}}" /></div>
    <div><label class="label">To</label><input class="input" type="date" name="to" value="{{filters.to}}" /></div>
    <div class="flex items-end"><button class="btn-primary" type="submit">Apply</button></div>
  </div>
  <div class="divider flex flex-wrap items-center gap-3 px-4 py-2 text-xs">
    <input class="input mono w-48" name="field" value="{{filters.field}}" placeholder="Field name, e.g. printReceipt" aria-label="Field" />
    <input class="input mono w-48" name="entityId" value="{{filters.entityId}}" placeholder="Record ID" aria-label="Record ID" />
    {{#if hasFilters}}<a class="link" href="/audit/configuration">Clear filters</a>{{/if}}
  </div>
</form>

{{#each groups}}
<div class="card">
  {{#if isGroup}}<div class="border-b border-slate-100 bg-slate-50/60 px-5 py-2 text-xs text-slate-500">{{events.length}} related changes · correlation <a class="link mono" href="/audit/cross-system?correlationId={{encode correlationId}}">{{correlationId}}</a></div>{{/if}}
  {{#each events}}
  <div class="{{#unless @first}}border-t border-slate-100{{/unless}}">
    <div class="flex flex-wrap items-start justify-between gap-3 px-5 py-3">
      <div>
        <a href="/audit/{{id}}" class="font-medium text-slate-900 hover:text-emerald-700">{{actionName}}</a>
        {{#if entityId}}<span class="mono text-xs text-slate-500"> · {{entityType}} {{entityId}}</span>{{/if}}
        <div class="text-xs text-slate-500">{{description}}</div>
      </div>
      <div class="text-right text-xs text-slate-500">
        <div>{{dateTime occurredAt}} {{badge outcome}}</div>
        <div>Changed by <span class="text-slate-900">{{default actorUsername (default actorUserId "—")}}</span>{{#if actorUserId}} <span class="mono">({{actorUserId}})</span>{{/if}}</div>
        <div>{{sourceSystemName}}{{#if trace.branchId}} · branch <span class="mono">{{trace.branchId}}</span>{{/if}}</div>
      </div>
    </div>
    {{#if hasChanges}}
    <div class="table-wrap"><table class="table">
      <thead><tr><th class="w-1/4">Setting</th><th>Previous value</th><th>New value</th><th></th></tr></thead>
      <tbody>{{#each diffRows}}<tr>
        <td class="font-medium text-slate-900">{{label}}</td>
        <td class="mono break-all {{#if isChanged}}text-red-600 line-through decoration-red-200{{else}}text-slate-500{{/if}}">{{default before "—"}}</td>
        <td class="mono break-all {{#if isChanged}}font-semibold text-emerald-700{{else}}text-slate-500{{/if}}">{{default after "—"}}</td>
        <td class="text-right">{{#if isChanged}}{{badge change}}{{/if}}</td>
      </tr>{{/each}}</tbody>
    </table></div>
    {{else}}<div class="px-5 pb-3 text-xs text-amber-700">No previous or new values were recorded for this change.</div>{{/if}}
  </div>
  {{/each}}
</div>
{{else}}
<div class="card"><div class="empty">{{#if hasFilters}}No configuration changes match these filters{{else}}No configuration changes have been received from connected systems{{/if}}</div></div>
{{/each}}
{{#if groups.length}}<div class="card">{{> pagination}}</div>{{/if}}
{{> footer}}
