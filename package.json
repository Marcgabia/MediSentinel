{
  "name": "MediSentinel",
  "version": "1.0.0",
  "description": "MediSentinel: A Centralized Audit Trail Management System for Integrated Pharmacy Operations",
  "main": "index.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xian": "nodemon index.js",
    "setup": "node scripts/setup.js",
    "migrate": "node migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
    "simulate": "node scripts/simulate-source.js",
    "dev-credential": "node scripts/dev-issue-credential.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand __tests__/unit",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "create:add-middleware": "node create.js middleware",
    "create:upload-middleware": "node create.js upload-middleware",
    "route:list": "node list-routes.js",
    "route:cache": "node route-cache.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "chart.js": "^4.6.1",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "inquirer": "^9.2.15",
    "multer": "^2.0.2",
    "mysql2": "^3.9.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/__tests__/setupEnv.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.18"
  }
}
